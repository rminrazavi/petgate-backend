# =============================================================================
# MOPET BACKEND (Strapi 5) — example environment. NO REAL SECRETS IN THIS FILE.
# =============================================================================
# SECRET ROTATION REQUIRED (Phase 6): a real .env was distributed with an
# earlier package, so every value below that is a credential must be treated as
# compromised and rotated before production:
#   APP_KEYS, API_TOKEN_SALT, ADMIN_JWT_SECRET, TRANSFER_TOKEN_SALT,
#   JWT_SECRET, ENCRYPTION_KEY, DATABASE_PASSWORD, SEP_TERMINAL_ID
# Rotating JWT_SECRET/ADMIN_JWT_SECRET invalidates existing sessions (expected).
# =============================================================================

HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database (PostgreSQL required) -------------------------------------------
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=mopet
DATABASE_USERNAME=mopet
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false
# Or use connection string:
# DATABASE_URL=postgres://mopet:tobemodified@127.0.0.1:5432/mopet

# --- Frontend / CORS ----------------------------------------------------------
# Public origin of the MOPET storefront. Used for CORS and as the default
# canonical host. No trailing slash.
FRONTEND_URL=http://localhost:3000

# Extra allowed origins, comma separated (staging, www alias, TWA host...).
# '*' is rejected on boot: MOPET sends credentialed requests.
CORS_ORIGINS=http://localhost:3000

# Where the browser is sent after SEP POSTs back to /api/payment/callback.
# The URL receives ONLY ?orderId=<resNum>; it is not proof of payment. The
# result page then calls GET /api/payment/status/:orderId.
# Leave empty to keep the legacy JSON callback response.
FRONTEND_PAYMENT_RESULT_URL=http://localhost:3000/payment/result

# --- SEP / Saman Kish (Bank Melli acquiring) ----------------------------------
# SERVER-SIDE ONLY. Never expose any SEP_* value to a browser or prefix it
# with NEXT_PUBLIC_.
SEP_TERMINAL_ID=replace-with-sep-terminal-id
SEP_CALLBACK_URL=https://your-domain.example/api/payment/callback
SEP_TOKEN_URL=https://sep.shaparak.ir/Payments/InitPayment.asmx
SEP_VERIFY_URL=https://sep.shaparak.ir/payments/referencepayment.asmx
SEP_PAYMENT_URL=https://sep.shaparak.ir/OnlinePG/OnlinePG
SEP_TIMEOUT_MS=15000

# --- Currency -----------------------------------------------------------------
# UNRESOLVED BUSINESS DECISION — must be set explicitly before live payments.
# Allowed: IRR | TOMAN
# The stored unit of Product/Variant.price, Order.finalPrice and Payment.amount
# is undocumented anywhere in this repository, and SEP's strTotalAmount is sent
# straight through with NO conversion (see services/gateways/sep.js). Setting
# this wrong overcharges or undercharges customers by 10x.
# Nothing multiplies or divides by 10 anywhere. Leave empty => live payment
# must stay disabled.
PAYMENT_CURRENCY=

# --- SMS (OTP delivery) -------------------------------------------------------
# Unset => codes are logged to the server console instead of sent (dev only).
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER=
